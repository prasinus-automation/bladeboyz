{
  "name": "bladeboyz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:server": "tsx watch server/index.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-server/index.mjs",
    "start": "node dist-server/index.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "@supabase/supabase-js": "^2.109.0",
    "bitecs": "^0.3.40",
    "three": "^0.170.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "jsdom": "^29.0.2",
    "playwright-core": "^1.61.1",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
